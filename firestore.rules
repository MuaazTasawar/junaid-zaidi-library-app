rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /admins/{adminId} {
      allow read: if request.auth != null && request.auth.uid == adminId;
      allow write: if false;
    }

    // Updated Authentication Workflow, Phase 1-3: a document here holds
    // an RSA-encrypted password while Pending. Only the Cloud Function
    // (Admin SDK, bypasses these rules entirely) can decrypt it, create
    // the Firebase + Koha accounts, and delete the field afterward — see
    // functions/index.js. No client, including the admin dashboard, ever
    // gets a decryption capability.
    match /student_requests/{requestId} {
      // Corrected in Phase 1: the Updated Authentication Workflow
      // creates NO real Firebase account for the student pre-approval,
      // so there is no request.auth.token.email to match against here —
      // the write comes from a throwaway anonymous session (see
      // FirestoreService.submitStudentRequest). request.auth != null
      // still gives basic abuse resistance (Firebase Auth rate-limits
      // anonymous sign-ins per device); everything else is validated by
      // shape/format instead of by identity, since identity genuinely
      // isn't verified until a librarian reviews the request by hand.
      allow create: if request.auth != null
                    && request.resource.data.email is string
                    && request.resource.data.email.matches('.*@isbstudent[.]comsats[.]edu[.]pk$')
                    && request.resource.data.status == 'Pending'
                    && request.resource.data.encryptedPassword is string
                    && request.resource.data.encryptedPassword.size() > 0;

      allow read: if request.auth != null
                  && (resource.data.email == request.auth.token.email
                      || exists(/databases/$(database)/documents/admins/$(request.auth.uid)));

      // Admins may only flip status (Pending -> Approved/Rejected).
      // Nobody client-side may edit encryptedPassword after creation —
      // that field is write-once from the client, then only ever
      // touched again by the Cloud Function.
      allow update: if request.auth != null
                    && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);

      allow delete: if false;
    }

    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.auth.token.email.matches('.*@isbstudent[.]comsats[.]edu[.]pk$');
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // Updated Authentication Workflow, Phase 7: student-initiated,
    // admin-mediated password change. `newEncryptedPassword` is the
    // same RSA-OAEP scheme as student_requests.encryptedPassword —
    // only the syncPasswordChange Cloud Function can decrypt it.
    match /password_change_requests/{requestId} {
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'Pending'
                    && request.resource.data.newEncryptedPassword is string
                    && request.resource.data.newEncryptedPassword.size() > 0;

      allow read: if request.auth != null
                  && (resource.data.uid == request.auth.uid
                      || exists(/databases/$(database)/documents/admins/$(request.auth.uid)));

      allow update: if request.auth != null
                    && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);

      allow delete: if false;
    }
  }
}