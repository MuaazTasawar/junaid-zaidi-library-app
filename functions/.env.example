# Copy this file to .env in the same folder and fill in real values.
# .env is already covered by the root .gitignore's Firebase section —
# double check `git status` never shows it staged before committing.

# ---- RSA private key (decrypts passwords encrypted by the app with
# CryptoConstants.passwordEncryptionPublicKeyPem) ----
# Paste the FULL PEM block, replacing real newlines with literal \n —
# dotenv only supports single-line values. Example shape:
# RSA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"
RSA_PRIVATE_KEY=""

# ---- Koha staff API (patron creation + password sync) ----
# This is a DIFFERENT credential from the student login endpoint the app
# already calls. Generate it in Koha's staff interface under
# Administration -> API keys (or OAuth2 client-credentials app, depending
# on your Koha version), granted the borrowers add/edit permission.
KOHA_STAFF_BASE_URL="https://REPLACE_WITH_YOUR_KOHA_URL"
KOHA_OAUTH_CLIENT_ID=""
KOHA_OAUTH_CLIENT_SECRET=""

# Category code new patrons are created under (Koha Administration ->
# Patron categories) — e.g. "ST" for student.
KOHA_PATRON_CATEGORY_CODE="ST"

# Library branch new patrons are assigned to (Koha Administration ->
# Libraries) — e.g. "MAIN".
KOHA_LIBRARY_BRANCHCODE="MAIN"